# Transactional email for the contact form (https://resend.com).
# Without it the form returns 503 and shows the fallback email address.
RESEND_API_KEY=

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX.
# Leave unset in local development and in preview deployments: the tag only
# renders when this is present, so previews never pollute the property.
#
# NOTE: Consent Mode v2 defaults to denied, so with no consent banner on the
# site GA4 currently records nothing. That is deliberate: a Greek company
# cannot drop an analytics cookie on an EU visitor without asking first.
# Adding a banner is a visible, site-wide decision and has not been made yet.
NEXT_PUBLIC_GA_ID=

# Google Search Console verification token, for the "HTML tag" method.
# Only needed if the property is not verified by DNS instead.
GOOGLE_SITE_VERIFICATION=
